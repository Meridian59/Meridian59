{
	"name": "kod",
	"scopeName": "source.kod",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#local-declaration" },
		{ "include": "#tokens" }
	],
	"repository": {
		"comments": {
			"name": "comment.line.double-slash.kod",
			"match": "%.*$"
		},
		"strings": {
			"name": "string.quoted.double.kod",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.kod",
					"match": "\\\\."
				}
			]
		},
		"local-declaration": {
			"begin": "(?i)\\blocal\\b",
			"beginCaptures": {
				"0": { "name": "keyword.control.kod" }
			},
			"end": ";",
			"patterns": [
				{ "include": "#comments" },
				{ "include": "#strings" },
				{
					"begin": "\\b([A-Za-z][A-Za-z0-9_]*)\\b([ \\t\\r\\n]*)(=)",
					"beginCaptures": {
						"1": { "name": "variable.other.kod" },
						"3": { "name": "keyword.operator.kod" }
					},
					"end": ",|(?=;)",
					"patterns": [
						{ "include": "#expr" }
					]
				},
				{
					"match": "\\b([A-Za-z][A-Za-z0-9_]*)\\b(?=[ \\t\\r\\n]*(?:,|;))",
					"captures": {
						"1": { "name": "variable.other.kod" }
					}
				}
			]
		},
		"expr": {
			"patterns": [
				{ "include": "#comments" },
				{ "include": "#strings" },
				{ "include": "#groups" },
				{ "include": "#tokens" }
			]
		},
		"groups": {
			"patterns": [
				{
					"begin": "\\(",
					"end": "\\)",
					"patterns": [
						{ "include": "#expr" }
					]
				},
				{
					"begin": "\\[",
					"end": "\\]",
					"patterns": [
						{ "include": "#expr" }
					]
				}
			]
		},
		"tokens": {
			"patterns": [
				{ "include": "#section-headers" },
				{ "include": "#keywords" },
				{ "include": "#constants" },
				{ "include": "#numbers" },
				{ "include": "#debug-call" },
				{ "include": "#builtins" },
				{ "include": "#classes" },
				{ "include": "#messages" },
				{ "include": "#parameters" },
				{ "include": "#self" },
				{ "include": "#operators" }
			]
		},
		"section-headers": {
			"name": "storage.modifier.kod",
			"match": "(?i)\\b(constants|resources|classvars|properties|messages)\\b"
		},
		"keywords": {
			"name": "keyword.control.kod",
			"match": "(?i)\\b(if|else|for|while|return|propagate|break|continue|include|end|is|in)\\b"
		},
		"constants": {
			"name": "constant.language.kod",
			"match": "(?i)\\b(true|false)\\b|\\$"
		},
		"numbers": {
			"name": "constant.numeric.kod",
			"match": "(?i)\\b0x[0-9a-f]+\\b|\\b[0-9]+\\b"
		},
		"debug-call": {
			"name": "invalid.kod",
			"match": "(?i)\\bDebug\\b(?=\\s*\\()"
		},
		"builtins": {
			"name": "support.function.kod",
			"match": "(?i)\\b(Abs|AddPacket|AddTableEntry|AppendTempString|Bound|BuildString|CanMoveInRoom|CanMoveInRoomFine|ClearPacket|ClearTempString|Cons|Create|CreateString|CreateTable|CreateTimer|DeleteTable|DeleteTableEntry|DeleteTimer|DelListElem|DumpStack|FindListElem|First|GetClass|GetInactiveTime|GetTableEntry|GetTempString|GetTime|GetTimeRemaining|IsClass|IsList|IsObject|IsPointInSector|Length|List|LoadRoom|MinigameNumberToString|MinigameStringToNumber|MoveListElem|Nth|ParseString|Post|Random|RecycleUser|Rest|RoomData|Send|SendCopyPacket|SendPacket|SendWebhook|SetFirst|SetNth|SetResource|SetString|Sqrt|StringConsistsOf|StringContain|StringEqual|StringLength|StringSubstitute)\\b(?=\\s*\\()"
		},
		"classes": {
			"name": "support.class.kod",
			"match": "&[A-Za-z][A-Za-z0-9_]*"
		},
		"messages": {
			"name": "entity.name.function.kod",
			"match": "@[A-Za-z][A-Za-z0-9_]*"
		},
		"parameters": {
			"name": "variable.parameter.kod",
			"match": "#[A-Za-z][A-Za-z0-9_]*"
		},
		"self": {
			"name": "variable.language.kod",
			"match": "(?i)\\bself\\b"
		},
		"operators": {
			"name": "keyword.operator.kod",
			"match": "(?i)\\b(?:and|or|not|mod)\\b|<=|>=|<>|[<>]=?|[+*/=|&~-]"
		}
	}
}
