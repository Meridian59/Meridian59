{
    "comments": {
        // Blakod comments run from "%" to the end of the line.
        "lineComment": "%"
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""]
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""]
    ],
    "indentationRules": {
        "increaseIndentPattern": "^.*\\{\\s*(%.*)?$",
        "decreaseIndentPattern": "^\\s*\\}"
    }
}
