%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
BoltSpell is AttackSpell

% Generic ranged "bolt" spell, such as lightning or slitherbolt

constants:

   include blakston.khd

resources:

classvars:

   vrProjectile_Icon = $

   vrHitSound_wav = $

   vbIsRangedAttack = TRUE

   viProjectileFlag = PROJ_FLAG_LIGHT_SOURCE

   % Projectile lighting information.
   viProjectileLightFlags = LIGHT_FLAG_ON | LIGHT_FLAG_DYNAMIC
   % Medium light range, out of 255.
   viProjectileLightIntensity = 100
   % Default color is lightning.
   viProjectileLightColor = LIGHT_LIGHTNING

   viChance_To_Increase = 7

properties:

   piRange = $

   % Maximum amount of bonus damage mana focus gives us for casting this spell.
   piManaFocusBonus = 10

   plHitSoundTimers = $

messages:

   CastSpell(who = $, lTargets = $)
   {
      local oOwner;
   
      % Show bolt flying through the air
      oOwner = Send(who,@GetOwner);
      Send(oOwner,@SomethingShot,#who=who,#target=First(lTargets), 
           #projectile=self,#flags=viProjectileFlag);

      Send(self,@SendScheduledSoundEffect,#who=who,#target=First(lTargets),#castRoom=oOwner);
	   propagate;
   }

   % Return the icon used to display a spell shooting through the air.
   GetProjectileIcon()
   {
      return vrProjectile_Icon;
   }

   % Return the speed at which a particular spell should appear to shoot through the air.
   GetProjectileSpeed()
   {
      return 5;
   }

   SendProjectileAnimation()
   {
      % Send animation info to user.  Default is no animation, display with group 1
      AddPacket(1,ANIMATE_NONE, 2,1);

      return;
   }      

   GetProjectileLightFlags()
   {
      return viProjectileLightFlags;
   }

   GetProjectileLightIntensity()
   {
      return viProjectileLightIntensity;
   }

   GetProjectileLightColor()
   {
      return viProjectileLightColor;
   }

   GetProjectileTravelTime(who = $, target = $)
   {
      local iSquaredDistanceToTarget, iSpeed, iDistance;
      
      if who = $ OR target = $
      {
         return $;
      }

      % Distance to the target squared
      iSquaredDistanceToTarget = Send(who,@SquaredDistanceTo,#what=target);

      % Get projectile speed
      iSpeed = Send(self,@GetProjectileSpeed);

      % Just in case
      if iSquaredDistanceToTarget = $ OR iSpeed <= 0
      {
         return $;
      }

      % In tenths of a square;
      iDistance = Sqrt(iSquaredDistanceToTarget * 100);
    
      % Cap at the maximum travel time of a porjectile (see projectile.c, )
      % This is in milliseconds, iDistance is tenths of a square
      % Divide by ten to get amount of squares, multiply by 1000 to get
      % Milliseconds, e.g. multiple iDistance by 100
      return Bound(iDistance*100/iSpeed, $ , 2000);
   }

   SendScheduledSoundEffect(who = $, target = $, castRoom = $)
   {
      local iTravelTime, tTimer;

      if vrHitSound_wav = $ OR target = $
      {
         return;
      }

      % Tavel time
      iTravelTime = Send(self,@GetProjectileTravelTime,#who=who,#target=target);
      if iTravelTime = $ 
      {
         return;
      }

      % Made a timer on self that calls @SoundEffectTimer in iTravelTime time
      tTimer = CreateTimer(self,@SoundEffectTimer,iTravelTime);

      % Big list of this to hit, when, and where
      plHitSoundTimers = Cons([tTimer,target,castRoom],plHitSoundTimers );

      return;
   }

   SoundEffectTimer(timer = $)
   {
      local hitDetails, oCastTarget, oCastRoom;

      % This list should be tiny, so this is fine, even though I think it is sorted 
      for hitDetails in plHitSoundTimers 
      {
         % We got the right timer
         if First(hitDetails) = timer
         {
            oCastTarget = Nth(hitDetails,2);
            oCastRoom = Nth(hitDetails,3); 
           
            % Cleanup
            plHitSoundTimers = DelListElem(plHitSoundTimers,hitDetails);

            % Still in the room and target still exists
            if NOT IsObject(oCastTarget)
            {
               return;
            }

            if Send(oCastTarget,@GetOwner) <> oCastRoom
            {
               return;
            }

            Send(oCastRoom,@SomethingWaveRoom,#what=oCastTarget,#wave_rsc=vrHitSound_wav);

            return;
           
         }
      }

      return;
   }

end
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
