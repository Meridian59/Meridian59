/* Generated by m59_add_resources: the binary's compiled resources (.res), handed
 * to the Win32 layer when the binary loads.  @M59_RES_FILE@ */

#if defined(__APPLE__)
#define M59_SECTION ".const_data"
#define M59_SYM(s) "_" #s
#else
#define M59_SECTION ".section .rodata"
#define M59_SYM(s) #s
#endif

__asm__(M59_SECTION "\n"
        ".balign 16\n"
        M59_SYM(m59_res_begin) ":\n"
        ".incbin \"@M59_RES_FILE@\"\n"
        M59_SYM(m59_res_end) ":\n"
        ".byte 0\n"
#if !defined(__APPLE__)
        ".previous\n"
#else
        ".text\n"
#endif
        );

extern const unsigned char m59_res_begin[] __asm__(M59_SYM(m59_res_begin));
extern const unsigned char m59_res_end[] __asm__(M59_SYM(m59_res_end));

/* win32/core: records the resources of the binary that is loading, or of a
 * DLL the layer provides (M59RegisterModuleResources). */
void M59RegisterResources(const void *begin, const void *end);
void M59RegisterModuleResources(const char *name, const void *begin, const void *end);

__attribute__((constructor)) static void m59_register_resources(void)
{
   @M59_RES_REGISTER@;
}
